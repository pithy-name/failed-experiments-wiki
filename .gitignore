# Cached source texts and API responses. Post texts must never be committed (copyright, PRD section 10).
.cache/

# Local environment and build outputs
.venv/
__pycache__/
*.pyc
.pytest_cache/
wiki.db
.DS_Store

# Demo build outputs: frames, audio, video (demo/script.md and demo/scenes.yaml are tracked)
demo/out/

# The page built only to take the report's screenshots
report/figures/_site/

# Print packs for the maintainer's review. They hold full post texts, which are never committed.
_print/

# Session-log drafts that could not be written to the central log
_session-log-update-*.md

# Files set aside for the maintainer to review and delete (nothing is deleted automatically)
_trash-review/
