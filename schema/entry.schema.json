{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/failed-experiments-wiki/entry.schema.json",
  "title": "Failed-experiments wiki entry",
  "description": "Front matter of one entry file in entries/. Every field is filterable. Closed lists are the enums below; research_area is a controlled list extendable by pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "research_area",
    "hypothesis",
    "claim_scope",
    "method",
    "models",
    "result",
    "failure_type",
    "confidence_true_negative",
    "retry_welcome",
    "evidence_level",
    "source",
    "contributor",
    "review",
    "dates",
    "info_hazard"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fe-[0-9]{4}-[0-9]{4}$",
      "description": "fe-YYYY-NNNN, unique. YYYY is the year the entry was created."
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "pattern": "^[^\\n]+$",
      "description": "One line, scoped: what was tried, on what, what happened."
    },
    "research_area": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "interpretability",
          "steering",
          "evals",
          "honesty",
          "sycophancy",
          "control",
          "oversight",
          "robustness",
          "rlhf",
          "alignment-training",
          "agents",
          "governance",
          "other"
        ]
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 10,
      "description": "What was expected."
    },
    "claim_scope": {
      "type": "string",
      "minLength": 10,
      "description": "Exactly what was tested, so the entry cannot be read as 'X never works'."
    },
    "method": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" },
      "description": "Techniques, free tags normalized to lowercase-hyphen."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "developer", "version", "size", "access"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "developer": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1, "description": "Or 'unknown'." },
          "size": { "type": "string", "minLength": 1, "description": "Or 'unknown'." },
          "access": { "enum": ["open-weight", "api", "unknown"] }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction"],
      "properties": {
        "direction": {
          "enum": ["null", "opposite", "smaller_than_expected", "mixed", "did_not_replicate"],
          "description": "The string 'null' means a null result. Quote it in YAML."
        },
        "effect_size": { "type": "number", "description": "As reported." },
        "ci_low": { "type": "number" },
        "ci_high": { "type": "number" },
        "n": { "type": "integer", "minimum": 0, "description": "Sample size, if reported." }
      }
    },
    "failure_type": {
      "enum": [
        "hypothesis_false",
        "underpowered",
        "implementation_bug_ruled_out",
        "implementation_bug_suspected",
        "measurement_noise",
        "hyperparams_unexplored",
        "infrastructure",
        "worked_but_abandoned",
        "unknown"
      ]
    },
    "confidence_true_negative": {
      "enum": ["low", "medium", "high"],
      "description": "How sure we are that the idea, as scoped, really does not work."
    },
    "checks_done": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" },
      "description": "e.g. positive-control, noise-floor, bug-audit, seed-sweep."
    },
    "limitations": { "type": "string", "description": "What was not tried." },
    "revival_conditions": { "type": "string", "description": "When it would be worth retrying." },
    "retry_welcome": {
      "type": "boolean",
      "description": "True when the evidence is weak enough that a better attempt is worthwhile."
    },
    "evidence_level": {
      "enum": ["author_report", "third_party_report", "independent_reproduction"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "title", "authors", "published", "quote"],
      "properties": {
        "type": {
          "enum": ["lesswrong", "alignment_forum"],
          "description": "Where the post was published. alignment_forum means an Alignment Forum crosspost: url is still the LessWrong address, and crosspost_url the Alignment Forum one."
        },
        "url": { "type": "string", "pattern": "^https://(www\\.)?(lesswrong\\.com|alignmentforum\\.org|greaterwrong\\.com)/posts/[A-Za-z0-9]+(/[^\\s]*)?$" },
        "crosspost_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "lw_tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "published": { "$ref": "#/$defs/date" },
        "section": { "type": "string" },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "15 words or fewer, verbatim from the source. The validator checks both."
        }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "handle"],
      "properties": {
        "type": { "enum": ["human", "agent"] },
        "handle": { "type": "string", "minLength": 1, "description": "GitHub handle. For agents, the account that ran them." },
        "agent_model": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "description": "Optional provenance note shown beside the contributor, e.g. 'drafted with model help, awaiting maintainer verification'." }
      },
      "if": { "properties": { "type": { "const": "agent" } }, "required": ["type"] },
      "then": { "required": ["agent_model", "tool"] }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed", "contested", "superseded"] },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle", "type", "date"],
            "properties": {
              "handle": { "type": "string", "minLength": 1 },
              "type": { "enum": ["human", "agent"] },
              "date": { "$ref": "#/$defs/date" },
              "notes": { "type": "string" },
              "agent_model": { "type": "string" }
            }
          }
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated"],
      "properties": {
        "experiment": { "$ref": "#/$defs/date" },
        "created": { "$ref": "#/$defs/date" },
        "updated": { "$ref": "#/$defs/date" }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation"],
        "properties": {
          "id": { "type": "string", "pattern": "^fe-[0-9]{4}-[0-9]{4}$" },
          "relation": { "enum": ["replicates", "contradicts", "extends", "same_hypothesis"] }
        }
      }
    },
    "info_hazard": { "enum": ["none", "review_needed"] }
  },
  "$defs": {
    "tag": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
  }
}
